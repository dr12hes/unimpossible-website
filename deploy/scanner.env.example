# Copied to /home/docker/unimpossible/.env on the server by deploy.sh if no .env exists there. Never commit the real one.
# Required
ANTHROPIC_API_KEY=
# Where the page and emails link back to
SCANNER_PUBLIC_ORIGIN=https://unimpossible.co.uk
# Email (Fastmail: smtp.fastmail.com, 465, app password for the hello@ account). Without it, emails are written to data/outbox/.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UNimpossible <hello@unimpossible.co.uk>
MAIL_BCC=hello@unimpossible.co.uk
# Competitor research: one of brave | serper, with its key. Without it the audit judges the site alone and says so.
SEARCH_PROVIDER=
BRAVE_API_KEY=
SERPER_API_KEY=
# Optional extras
COMPANIES_HOUSE_API_KEY=
GOOGLE_PLACES_API_KEY=
OPENPAGERANK_API_KEY=
# Admin listing at /api/admin/scans with header X-Admin-Key
SCANNER_ADMIN_KEY=
# Models (defaults shown)
SCANNER_HOOK_MODEL=claude-sonnet-5-5
SCANNER_NOTES_MODEL=claude-haiku-5-5
SCANNER_JUDGE_MODEL=claude-sonnet-5-5
SCANNER_WRITER_MODEL=claude-sonnet-5-5
